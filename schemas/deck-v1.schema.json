{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrzzzz.github.io/lexora/schemas/deck-v1.schema.json",
  "title": "Lexora deck v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "revision", "title", "cards"],
  "properties": {
    "format": { "const": "lexora.deck" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "description": { "type": "string", "maxLength": 2000 },
    "language": { "$ref": "#/$defs/locale" },
    "answerLanguage": { "$ref": "#/$defs/locale" },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/source" }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/card" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!constructor$|prototype$)[A-Za-z0-9][A-Za-z0-9:._/-]{0,159}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^https?://[^\\s]+$"
        },
        "license": { "type": "string", "maxLength": 200 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "answer"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["vocabulary", "knowledge"] },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "language": { "$ref": "#/$defs/locale" },
        "answerLanguage": { "$ref": "#/$defs/locale" },
        "acceptedAnswers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "pronunciations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "label": { "type": "string", "maxLength": 80 },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "translation": { "type": "string", "maxLength": 4000 }
            }
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        },
        "note": { "type": "string", "maxLength": 8000 },
        "sourceRefs": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/id" }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
